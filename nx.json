{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "nxCloudId": "6705466d4003f9515ff74f33",
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.[cm]js",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/test-setup.[jt]s",
      "!{projectRoot}/jest.config.[jt]s",
      "!{projectRoot}/vite(st)?.config.(m)?ts"
    ],
    "sharedGlobals": ["{workspaceRoot}/.github/workflows/ci.yml"]
  },
  "targetDefaults": {
    "e2e-ci--**/*": {
      "dependsOn": ["^build"]
    },
    "@nx/webpack:webpack": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "@nx/js:tsc": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "options": {
        "main": "{projectRoot}/src/index.ts",
        "outputPath": "dist/{projectRoot}",
        "tsConfig": "{projectRoot}/tsconfig.lib.json"
      },
      "outputs": ["{options.outputPath}"]
    },
    "@nx/js:swc": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "@nx/esbuild:esbuild": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "options": {
        "outputPath": "dist/{projectRoot}",
        "main": "{projectRoot}/src/index.ts",
        "tsConfig": "{projectRoot}/tsconfig.lib.json",
        "generatePackageJson": false,
        "format": ["cjs"]
      },
      "outputs": ["{options.outputPath}"]
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "{workspaceRoot}/dist/packages/{projectName}"
      }
    }
  },
  "generators": {
    "@nx/js": {
      "library": {
        "bundler": "esbuild",
        "linter": "eslint",
        "minimal": true,
        "publishable": true,
        "simpleName": true,
        "testEnvironment": "node",
        "unitTestRunner": "vitest"
      }
    },
    "@nx/node": {
      "application": {
        "bundler": "esbuild",
        "docker": true,
        "e2eTestRunner": "none",
        "linter": "eslint",
        "swcJest": true,
        "unitTestRunner": "jest"
      },
      "library": {
        "buildable": true,
        "compiler": "swc",
        "linter": "eslint",
        "publishable": true,
        "simpleModuleName": true,
        "testEnvironment": "node",
        "unitTestRunner": "jest"
      }
    },
    "@nx/react": {
      "application": {
        "babel": true,
        "style": "tailwind",
        "linter": "eslint",
        "bundler": "vite"
      },
      "component": {
        "style": "tailwind"
      },
      "library": {
        "style": "tailwind",
        "linter": "eslint",
        "unitTestRunner": "vitest"
      }
    },
    "@nx/next": {
      "application": {
        "style": "css",
        "linter": "eslint"
      }
    }
  },
  "release": {
    "groups": {
      "nx-plugins": {
        "projects": ["nx-payload", "create-nx-payload"],
        "projectsRelationship": "fixed",
        "version": {
          "groupPreVersionCommand": "pnpm nx run-many -t build"
        },
        "releaseTag": {
          "pattern": "{releaseGroupName}-{version}"
        }
      },
      "packages": {
        "projects": ["nx-ai", "fly-node"],
        "projectsRelationship": "independent",
        "version": {
          "groupPreVersionCommand": "pnpm nx run-many -t build"
        }
      },
      "apps": {
        "projects": ["cms", "web"],
        "projectsRelationship": "independent",
        "version": {
          "updateDependents": "never"
        },
        "releaseTag": {
          "pattern": "{projectName}-{version}",
          "checkAllBranchesWhen": true
        },
        "changelog": {
          "createRelease": "github",
          "file": false,
          "entryWhenNoChanges": false,
          "renderOptions": {
            "authors": false
          }
        }
      }
    },
    "changelog": {
      "automaticFromRef": true,
      "git": {
        "commitMessage": "chore(release): packages"
      },
      "projectChangelogs": {
        "createRelease": "github",
        "renderOptions": {
          "authors": false
        }
      },
      "workspaceChangelog": false
    },
    "version": {
      "conventionalCommits": true,
      "fallbackCurrentVersionResolver": "disk",
      "preserveLocalDependencyProtocols": false
    },
    "conventionalCommits": {
      "types": {
        "feat": {
          "semverBump": "minor",
          "changelog": {
            "title": "\u2728 Features"
          }
        },
        "fix": {
          "semverBump": "patch",
          "changelog": {
            "title": "\ud83d\udc1e Bug Fixes"
          }
        },
        "perf": {
          "semverBump": "patch",
          "changelog": {
            "title": "\u26a1\ufe0f Performance Improvements"
          }
        },
        "revert": {
          "semverBump": "patch",
          "changelog": {
            "title": "\ud83d\udd19 Revert Code Changes"
          }
        },
        "docs": {
          "semverBump": "patch",
          "changelog": {
            "title": "\ud83d\udcc4 Documentation"
          }
        },
        "chore": {
          "semverBump": "patch",
          "changelog": {
            "title": "\u2699\ufe0f Miscellaneous Chores"
          }
        },
        "refactor": {
          "semverBump": "patch",
          "changelog": {
            "title": "\ud83e\uddf9 Code Refactoring"
          }
        },
        "style": {
          "semverBump": "patch",
          "changelog": {
            "title": "\ud83c\udfa8 Code Style"
          }
        },
        "test": {
          "semverBump": "none",
          "changelog": {
            "title": "\u2705 Tests"
          }
        },
        "ci": {
          "semverBump": "none",
          "changelog": {
            "title": "\ud83e\udd16 Continuous Integration"
          }
        },
        "deps": {
          "semverBump": "patch",
          "changelog": {
            "hidden": true
          }
        }
      }
    },
    "releaseTag": {
      "pattern": "{projectName}-{version}"
    }
  },
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "exclude": ["packages/**/*__tmpl__"],
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/jest/plugin",
      "exclude": ["e2e/**/*"],
      "options": {
        "targetName": "test"
      }
    },
    {
      "plugin": "@nx/remix/plugin",
      "options": {
        "startTargetName": "start",
        "buildTargetName": "build",
        "devTargetName": "dev",
        "typecheckTargetName": "typecheck",
        "serveStaticTargetName": "serve-static",
        "staticServeTargetName": "static-serve"
      }
    },
    {
      "plugin": "@nx/vite/plugin",
      "options": {
        "buildTargetName": "build",
        "serveTargetName": "serve",
        "previewTargetName": "preview",
        "serveStaticTargetName": "serve-static",
        "typecheckTargetName": "typecheck"
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "test"
      }
    },
    {
      "plugin": "@nx/next/plugin",
      "options": {
        "startTargetName": "start",
        "buildTargetName": "build",
        "devTargetName": "dev",
        "serveStaticTargetName": "serve-static"
      }
    },
    {
      "plugin": "@nx/playwright/plugin",
      "exclude": ["apps/web-e2e/**"],
      "options": {
        "targetName": "e2e",
        "ciTargetName": "e2e-ci"
      }
    },
    "./packages/nx-payload/plugin.ts",
    {
      "plugin": "@nx/storybook/plugin",
      "options": {
        "serveStorybookTargetName": "storybook",
        "buildStorybookTargetName": "build-storybook",
        "testStorybookTargetName": "test-storybook",
        "staticStorybookTargetName": "static-storybook",
        "buildDepsTargetName": "build-deps",
        "watchDepsTargetName": "watch-deps"
      }
    }
  ],
  "sync": {
    "globalGenerators": [
      "dev-plugin:block-meta-sync",
      "dev-plugin:externalize-deps-sync",
      "dev-plugin:theme-sync",
      "dev-plugin:web-package-sync"
    ]
  },
  "analytics": true,
  "migrate": {
    "agentic": true
  }
}
