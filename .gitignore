# Act
.secrets

vite.config.*.timestamp*
vitest.config.*.timestamp*

# No nested lockfiles, except apps/web which ships a standalone runtime
# lockfile for a reproducible Docker install (kept in sync by `nx sync`).
apps/**/pnpm-lock.yaml
!apps/web/pnpm-lock.yaml

# TypeScript
**/*.tsbuildinfo

# Next.js
.next
out

# Fly.io temp config files
.fly-config-*.toml
.fly-deploy-*.toml

# AI
.claude/worktrees
.claude/settings.local.json

# Database backups
/backups/

# Infisical credentials (tools)
.env.infisical

# Local environment overrides (may contain secrets)
.env.local
*.env.local

.nx/self-healing

.nx/migrate-runs

# Generated showcase imagery, reviewed by hand before upload
.showcase-images/
