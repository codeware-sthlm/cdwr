INFISICAL_PROJECT_ID=
INFISICAL_SITE=eu

# Option 1: Universal Auth
# INFISICAL_CLIENT_ID=
# INFISICAL_CLIENT_SECRET=

# Option 2: Service Token
INFISICAL_SERVICE_TOKEN=

# The GitHub App a launched implementing session acts as (README, "The agent queue")
AGENT_GITHUB_APP_ID=
AGENT_GITHUB_APP_INSTALLATION_ID=
# A .pem outside every checkout, mode 600
AGENT_GITHUB_APP_KEY_PATH=

# The agent-queue Supabase project the queue writes its telemetry to (optional; unset means none is sent)
AGENT_SUPABASE_URL=
AGENT_SUPABASE_SERVICE_KEY=
