# Public configuration for apps/web. Committed on purpose: the build reads it,
# in CI as much as locally. Personal overrides go in .env.local, which is
# ignored and wins over this file.
#
# No secrets belong here. Everything secret comes from Infisical, injected by
# `nx dev web` through tools/scripts/with-secrets.mjs.
#
# TENANT_ID picks the seeded workspace; PAYLOAD_API_HOST stands in for the
# /tenants/<id> folder that development does not have in the vault.

PAYLOAD_URL=http://localhost:3000
PORT=4200
DEBUG=true

# Placeholder, not a secret — Infisical supplies the real development value
SIGNATURE_SECRET=supers3cret

DEPLOY_ENV=development
NODE_ENV=development
# Use 'sun' tenant for a swedish site and e.g. 'moon' for an english site
TENANT_ID=sun

# Deprecated
PAYLOAD_API_HOST=http://localhost:4200
