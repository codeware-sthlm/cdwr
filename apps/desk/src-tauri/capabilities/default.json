{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The desk's window: Linear's API over plugin-http, its own settings store, and links to Linear and GitHub only",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://api.linear.app/graphql" }]
    },
    "store:allow-load",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://linear.app/codeware/*" },
        { "url": "https://github.com/codeware-sthlm/*" },
        { "url": "https://github.com/apps/codeware-agent" }
      ]
    }
  ]
}
