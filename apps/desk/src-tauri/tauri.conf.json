{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Agent Desk",
  "version": "0.1.0",
  "identifier": "se.codeware.agent-desk",
  "build": {
    "frontendDist": "../../../dist/apps/desk",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "Agent Desk",
        "width": 1280,
        "height": 860,
        "resizable": true,
        "fullscreen": false,
        "label": "main",
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://*.supabase.co wss://*.supabase.co; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
