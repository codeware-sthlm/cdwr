# E2E environment for the cms and headless pair, read by the Playwright config.
# Each server gets its own env from the config; nothing here is applied to the
# shell. The cms-e2e suite has its own database and ports, so the two can run side by side.

# Isolated Postgres container (port 5434, database headless-e2e — separate from dev on 5432 and cms-e2e on 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/headless-e2e
DATABASE_SCHEMA=payload
POSTGRES_DB=headless-e2e
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Reduce noise in test output
LOG_LEVEL=error

# Both servers must sign and verify with the same secret
SIGNATURE_SECRET=e2e-signature-secret

# Closes headless only; the cms is reached by headless server-side and stays open
SITE_GATE_PASSWORD=e2e-site-gate-password

# Always seed from the local static file so test data is deterministic
SEED_SOURCE=local
SEED_STRATEGY=delta

# Own media folder, so a reset never touches another suite's uploads
MEDIA_DIR=tmp/headless-e2e-media

# Never reach Supabase — no S3 storage, no remote seed media (matches CI, which sets neither)
S3_ACCESS_KEY_ID=
SEED_DATA_URL=
