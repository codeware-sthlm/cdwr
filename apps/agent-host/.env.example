# The host's only secrets: a machine identity that is a Viewer of the Infisical project agent-host,
# which holds production /agent-queue and nothing else. The container reads every other key from
# that folder at start.
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_SITE=eu
# AGENT_IMAGE_TAG=sha-abc1234

# Without the identity, set the keys here instead (a local run, or a test without the vault).
# A key set here also wins over the vault's value.
# AGENT_GITHUB_APP_ID=
# AGENT_GITHUB_APP_INSTALLATION_ID=
# The PEM contents; newlines may be written as real lines in a quoted value
# AGENT_GITHUB_APP_KEY=
# The queue's Linear app, which writes as the app user; the key is the fallback until it is revoked
# AGENT_QUEUE_LINEAR_CLIENT_ID=
# AGENT_QUEUE_LINEAR_CLIENT_SECRET=
# AGENT_QUEUE_LINEAR_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=
# SLACK_WEBHOOK_URL=
# SENTRY_DSN=
