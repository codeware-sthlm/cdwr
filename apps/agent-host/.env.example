# The host's only secrets: a machine identity that is a Viewer of the Infisical project agent-host,
# which holds production /agent-queue and nothing else. The container reads every other key from
# that folder at start.
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_SITE=eu
# AGENT_IMAGE_TAG=sha-abc1234

# Without the identity, set the keys here instead (a local run, or a test without the vault).
# A key set here also wins over the vault's value.
# AGENT_GITHUB_APP_ID=
# AGENT_GITHUB_APP_INSTALLATION_ID=
# The PEM contents; newlines may be written as real lines in a quoted value
# AGENT_GITHUB_APP_KEY=
# The queue's Linear app, which writes as the app user; the key is the fallback until it is revoked
# AGENT_QUEUE_LINEAR_CLIENT_ID=
# AGENT_QUEUE_LINEAR_CLIENT_SECRET=
# AGENT_QUEUE_LINEAR_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=
# SLACK_WEBHOOK_URL=
# SENTRY_DSN=

# The platform step's read-only access, kept in the agent-host Infisical /agent-queue folder and used only by that step.
# A read-only Fly org token
# FLY_API_TOKEN=
# A read-only role on the cms production database
# PLATFORM_DATABASE_URL=
# The nightly backup's read-only role on the cms database: its session-pooler url, from agent-host Infisical /agent-queue
# PLATFORM_BACKUP_DATABASE_URL=
# An Infisical identity with read on /apps/* and /tenants/*
# PLATFORM_INFISICAL_CLIENT_ID=
# PLATFORM_INFISICAL_CLIENT_SECRET=
# PLATFORM_INFISICAL_PROJECT_ID=
# A Sentry auth token with org:read, project:read, event:read (scope names unverified), and the org slug
# PLATFORM_SENTRY_AUTH_TOKEN=
# PLATFORM_SENTRY_ORG=
# The cms's UMAMI_URL, and the read API_KEY from /integrations/umami
# PLATFORM_UMAMI_URL=
# PLATFORM_UMAMI_API_KEY=

# The desk's restart and gate commands' write access, in the same folder, kept apart from the read-only
# credentials above and named only on the cdwr command line that applies a command.
# An org-scoped Fly deploy token, with an expiry
# DESK_FLY_TOKEN=
# An Infisical identity with write on production secrets
# DESK_INFISICAL_CLIENT_ID=
# DESK_INFISICAL_CLIENT_SECRET=
# DESK_INFISICAL_PROJECT_ID=
