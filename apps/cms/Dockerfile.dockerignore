.DS_Store
.git

# Config
.settings
.verdaccio
.vscode

# Nx
.nx
migrations.json
# `tools/*` rather than `tools`, so the exception below can re-include a child:
# excluding the directory itself would take its whole subtree with it.
tools/*
# The root eslint config imports these, and `@nx/eslint/plugin` reads that
# config while building the project graph — which every nx command does,
# `nx build` included. Without them the image build fails resolving them.
!tools/eslint-rules
*.log

# Temporary files
coverage
dist
node_modules
tmp

# Don't let host lock files detect wrong package manager in Dockerfile
bun.lockb
package-lock.json
#pnpm-lock.yaml
yarn.lock

# Other apps
/apps/*
!/apps/cms

# Target environment variables for local development
.env.*
