# Public configuration for apps/cms. Committed on purpose: the build reads it,
# in CI as much as locally. Personal overrides go in .env.local, which is
# ignored and wins over this file.
#
# No secrets belong here. Everything secret comes from Infisical, injected by
# `nx dev cms` through tools/scripts/with-secrets.mjs.
#
# TENANT_ID selects which workspace the site serves, or empty for host mode.
# The seeded ones - moon, star, sun - need nothing beside it. Any other
# workspace also needs PAYLOAD_API_KEY, in .env.local.

# Local database. The Infisical development folder carries the same value, so
# these agree whether or not a session is available
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cms
DATABASE_SCHEMA=payload
LOG_LEVEL=info

# Placeholders, not secrets. Infisical supplies the real development values and
# overrides these; they exist so a fresh clone and CI can build without a session
PAYLOAD_SECRET_KEY=secret
SIGNATURE_SECRET=supers3cret

CORS_URLS=*
CSRF_URLS=
FONT_ASSETS_BASE_URL=https://tiuqdqnfadzjngucaatb.supabase.co/storage/v1/object/public/fonts

APP_NAME=cdwr-cms
DEPLOY_ENV=development
CUSTOM_URL=
FLY_URL=
PR_NUMBER=

# ============================================
# APP MODE CONFIGURATION
# ============================================
# These variables control whether the app runs in:
# - Tenant scoped mode: When TENANT_ID is set
# - CMS host mode: When TENANT_ID is empty/unset
#
# Required for tenant scoped mode:
# - PAYLOAD_API_KEY: Tenant unique key. In development it is read from the
#   seed data via TENANT_ID, which only describes the seeded workspaces
#
# Required for CMS host mode:
# - SIGNATURE_SECRET: Verify incoming requests from tenants (loaded from Infisical secret)
#
# In development with TENANT_ID set, you can use X-Tenant-Host header to override
# In development the tenant id is usually a seeded tenant slug: moon, sun, star
TENANT_ID=moon
# Optional for those three - their key comes from the seed data. A workspace
# made with `cdwr tenant create` is not in the seed, so set the key it reported.
# Put it in .env.local: it belongs to one database, not to the repository
# PAYLOAD_API_KEY=
# Restricted fonts that must follow licensing rules (a public URL is safe to be source controlled)
RESTRICTED_FONTS=nasalization

# Gate the site with a password before showing any content
# SITE_GATE_PASSWORD=

# Infisical credentials
# Postgres credentials required to initialize the local database correctly
POSTGRES_DB=cms
POSTGRES_PASSWORD=postgres
POSTGRES_USER=postgres

# Sentry is disabled by default for local development.
# To enable it, uncomment the lines below and provide your own values.
# SENTRY_DSN=<set your Sentry DSN here>
# SENTRY_ORG=<set your Sentry organization slug here>
# SENTRY_PROJECT=<set your Sentry project slug here>
# SENTRY_AUTH_TOKEN=<set your Sentry auth token here>
# NEXT_PUBLIC_DEPLOY_ENV=<set your public deploy environment here>
# NEXT_PUBLIC_SENTRY_DSN=<set SENTRY_DSN value here for client-side>

# S3 storage is not used in development — Payload uses local file storage (apps/cms/public/media).
# Uncomment and fill in to use Supabase S3 in development instead.
# SendGrid credentials (higher priority than SMTP)
# Any SMTP relay. Leave USERNAME/PASSWORD empty for a credential-less local
# catcher such as Mailpit; set both for an authenticated relay instead, e.g.
# Mailtrap's SMTP sandbox. Port 465 uses implicit TLS (SMTPS); any other port
# starts plain and upgrades via STARTTLS. With nothing configured at all,
# development falls back to a disposable Ethereal inbox created on the first send.
# Note! Ensure that a local SMTP server is running if you intend to use it for development.
#       Run: nx dx:mail cms
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_FROM_ADDRESS=dev@codeware.local
# SMTP_FROM_NAME=Codeware Dev
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Human form validation is driven by Turnstile when keys are provided,
# backed up by honeypot and clock as secondary validation mechanisms.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Set to true to prevent database sync and behave as if it's production.
# This is required when serving the app after running migrations locally.
# Otherwise we'll probably run into race condition sync issues.
DISABLE_DB_PUSH=false

# Uncomment to run production backup locally after testing latest migration
# (start the container via: pnpm cdwr → test-migration, choose to keep it running)
# DEPLOY_ENV=production
# DISABLE_DB_PUSH=true
# TENANT_ID=
