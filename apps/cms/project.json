{
  "name": "cms",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/cms",
  "projectType": "application",
  "tags": ["scope:cms", "type:app"],
  "// targets": "remove custom dev target once @cdwr/nx-payload supports turbopack (COD-319)",
  "targets": {
    "build": {
      "dependsOn": ["^build", "studio-types"]
    },
    "studio-types": {
      "metadata": {
        "description": "Collect the declarations the component studio's editor type-checks against, into public/studio-types.json. `build` depends on it; `dev` runs it inline."
      },
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx src/utils/generate-studio-types.ts",
        "cwd": "apps/cms"
      },
      "cache": true,
      "inputs": ["default", "^production", "{workspaceRoot}/pnpm-lock.yaml"],
      "outputs": ["{projectRoot}/public/studio-types.json"]
    },
    "dev": {
      "executor": "dev-plugin:infisical-run",
      "options": {
        "path": "/apps/cms",
        "cwd": "apps/cms",
        "commands": [
          "npx tsx src/utils/generate-studio-types.ts",
          "next dev --turbopack"
        ],
        "env": {
          "SEED_SOURCE": "local",
          "SEED_STRATEGY": "delta"
        }
      },
      "configurations": {
        "host": {
          "env": {
            "SEED_SOURCE": "local",
            "SEED_STRATEGY": "delta",
            "TENANT_ID": ""
          }
        }
      }
    },
    "dev-fresh": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["echo 'y' | nx payload cms migrate:fresh", "nx dev cms"],
        "parallel": false
      }
    },
    "reset-db": {
      "executor": "dev-plugin:infisical-run",
      "options": {
        "path": "/apps/cms",
        "cwd": "apps/cms",
        "commands": ["npx tsx src/utils/reset-db.ts"],
        "env": {
          "DISABLE_DB_PUSH": "true",
          "NODE_ENV": "development",
          "SEED_SOURCE": "off"
        }
      }
    },
    "seed": {
      "metadata": {
        "description": "Ad-hoc seed process using the local-api."
      },
      "executor": "dev-plugin:infisical-run",
      "options": {
        "path": "/apps/cms",
        "cwd": "apps/cms",
        "commands": ["npx tsx src/utils/seed.ts"],
        "env": {
          "NODE_ENV": "development",
          "SEED_SOURCE": "local",
          "SEED_STRATEGY": "delta"
        }
      }
    },
    "re-seed": {
      "metadata": {
        "description": "Ad-hoc seed process that first resets the database and then seeds it, using the local-api."
      },
      "executor": "nx:run-commands",
      "options": {
        "commands": ["nx reset-db cms", "nx seed cms"],
        "parallel": false
      }
    },
    "verify": {
      "metadata": {
        "description": "Verify that the last migration works as expected."
      },
      "executor": "dev-plugin:infisical-run",
      "options": {
        "path": "/apps/cms",
        "cwd": "apps/cms",
        "commands": ["npx tsx src/utils/verify-last-migration.ts"],
        "env": {
          "DISABLE_DB_PUSH": "true",
          "NODE_ENV": "development",
          "SEED_SOURCE": "off"
        }
      }
    },
    "test-migrate": {
      "metadata": {
        "description": "Build the CMS Docker image and run migrate.mjs against a fresh postgres container to validate the migration bundle end-to-end."
      },
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose -f apps/cms/docker-compose.migrate.yml up --build --abort-on-container-exit --exit-code-from migrate; RESULT=$?; docker compose -f apps/cms/docker-compose.migrate.yml down -v --remove-orphans; exit $RESULT"
      }
    },
    "dx:mail": {
      "metadata": {
        "description": "Developer experience (DX) - Start a Mailpit inbox in a Docker container"
      },
      "executor": "nx:run-commands",
      "options": {
        "command": "(docker ps -q -f name=^mailpit-cms$ | grep -q . || docker run --name mailpit-cms --rm -d -p 1025:1025 -p 8025:8025 axllent/mailpit) && echo 'Mailpit inbox: http://localhost:8025 (SMTP on 1025)'"
      }
    },
    "dx:secrets": {
      "metadata": {
        "description": "Refresh the offline copy of the development vault, for working without a session."
      },
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/scripts/with-secrets.mjs --refresh-offline"
      }
    }
  }
}
