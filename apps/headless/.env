# Public defaults for local development; .env.local overrides any of them, e.g. for another tenant.
# PAYLOAD_API_KEY is tenant moon's dev seed key. `nx dev headless` reads /tenants/moon/apps/headless,
# which imports /apps/headless and /apps/cms/signature as a deploy does; these are the fallback without a vault.
PAYLOAD_URL=http://localhost:3000
TENANT_ID=moon
PAYLOAD_API_KEY=b9c2fb25-df77-4304-a60a-028779a2cb37
SIGNATURE_SECRET=supers3cret
