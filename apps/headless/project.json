{
  "name": "headless",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/headless/src",
  "projectType": "application",
  "tags": ["scope:headless", "type:app"],
  "targets": {
    "build": {
      "inputs": [
        "production",
        "^production",
        { "externalDependencies": ["vite"] },
        { "env": "DEPLOY_ENV" },
        { "env": "SENTRY_AUTH_TOKEN" },
        { "env": "SENTRY_DSN" },
        { "env": "SENTRY_ORG" },
        { "env": "SENTRY_PROJECT" },
        { "env": "SENTRY_RELEASE" }
      ],
      "outputs": ["{projectRoot}/.output"]
    },
    "dev": {
      "metadata": {
        "description": "Starts the Vite dev server, signing with the cms dev vault signature secret"
      },
      "executor": "dev-plugin:infisical-run",
      "continuous": true,
      "options": {
        "path": "/apps/cms/signature",
        "cwd": "apps/headless",
        "commands": ["vite"]
      }
    },
    "dx:secrets": {
      "metadata": {
        "description": "Refresh the offline copy of the signature secret, for working without a session."
      },
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm cdwr infisical cache --path=/apps/cms/signature --app=headless --yes"
      }
    },
    "start": {
      "metadata": {
        "description": "Runs the built Node server from .output",
        "help": {
          "command": "nx start headless"
        }
      },
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": ["build"],
      "options": {
        "command": "node .output/server/index.mjs",
        "cwd": "apps/headless"
      }
    }
  }
}
