{
  "name": "storybook",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/storybook/src",
  "projectType": "application",
  "tags": ["scope:storybook", "type:app"],
  "targets": {
    "storybook": {
      "syncGenerators": ["dev-plugin:theme-sync"],
      "options": {
        "port": 6006,
        "config-dir": ".storybook"
      },
      "configurations": {
        "ci": {
          "args": ["--quiet"]
        }
      }
    },
    "build-storybook": {
      "syncGenerators": ["dev-plugin:theme-sync"],
      "options": {
        "statsJson": true,
        "config-dir": ".storybook",
        "output-dir": "../../dist/storybook"
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "chromatic": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-storybook"],
      "options": {
        "command": "chromatic --no-interactive --config-file apps/storybook/chromatic.config.json"
      }
    }
  }
}
