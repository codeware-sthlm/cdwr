# E2E environment — applied on top of apps/cms/.env.local by the Playwright config.
# Overrides dev defaults so e2e runs against an isolated database and known state.

# Isolated Postgres container (port 5433, database cms-e2e — separate from dev on 5432/cms)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/cms-e2e
DATABASE_SCHEMA=payload
POSTGRES_DB=cms-e2e
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# CMS runs as moon tenant in tenant mode
TENANT_ID=moon

# Reduce noise in test output
LOG_LEVEL=error

# Every e2e request arrives from the same address, so the per-address
# allowance a real site wants would refuse the suite partway through
HUMAN_CHECK_RATE_LIMIT=1000

# The whole suite runs behind the site gate, so the gate is exercised on every
# spec rather than only in its own. Global setup walks through it once and every
# context inherits the cookie; the gate's own spec drops it again to prove the
# refusals
SITE_GATE_PASSWORD=e2e-site-gate-password

# Always seed from the local static file so test data is deterministic
SEED_SOURCE=local
SEED_STRATEGY=delta
