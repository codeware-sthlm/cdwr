{
  "name": "nx-payload-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "e2e/nx-payload-e2e/src",
  "tags": ["scope:nx-payload-e2e", "type:e2e"],
  "implicitDependencies": ["create-nx-payload", "nx-payload"],
  "targets": {
    "e2e": {
      "options": {
        "runInBand": true
      },
      "configurations": {
        "docker": {
          "testPathPatterns": "\"\\.docker\\.spec|\\.ui\\.spec\""
        },
        "main": {
          "testPathPatterns": "\\.main\\.spec"
        },
        "quick": {
          "testPathPatterns": "\\.quick\\.spec"
        }
      }
    }
  }
}
